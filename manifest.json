{
  "manifest_version": 3,
  "name": "ColorblindExtension",
  "version": "1.0",
  "description": "extension description",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab", "scripting"]
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["textures/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
